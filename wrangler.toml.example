name = "sub-store"
main = "src/workers.js"
compatibility_date = "2025-11-17"
compatibility_flags = ["nodejs_compat"]

[vars]
DEBUG = false
SUB_STORE_FRONTEND_BACKEND_PATH = "__SUB_STORE_FRONTEND_BACKEND_PATH__"

[[durable_objects.bindings]]
name = "STORE_DO"
class_name = "StoreDO"

# Existing deployments must keep the historical tag before applying v2.
[[migrations]]
tag = "v1"
new_sqlite_classes = ["IndexDO", "UserDO"]

[[migrations]]
tag = "v2"
new_sqlite_classes = ["StoreDO"]
deleted_classes = ["IndexDO", "UserDO"]

[triggers]
crons = ["0 */6 * * *"]

[assets]
directory = "./public/frontend"
binding = "ASSETS"
not_found_handling = "single-page-application"
run_worker_first = true
